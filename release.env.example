# release.env.example — signing configuration for the MenuMeters release scripts.
#
# Copy this file to release.env (which is gitignored) and fill in your own
# values, OR export these variables in your shell before running the scripts.
# build-clt.sh and the scripts in Scripts/ source release.env automatically.
#
#   cp release.env.example release.env
#   $EDITOR release.env
#
# These are intentionally NOT committed so the repo carries no account-specific
# identifiers.

# Your Apple Developer Team ID (10 chars, e.g. ABCDE12345). Find it at
# https://developer.apple.com/account → Membership details. With it set,
# build-clt.sh signs with your Developer ID Application identity.
TEAM_ID="YOURTEAMID"

# notarytool keychain profile name. Create one once with:
#   xcrun notarytool store-credentials "menumeters-notary" \
#     --apple-id "you@example.com" \
#     --team-id  "$TEAM_ID" \
#     --password "<app-specific-password>"
#
# An existing account-wide profile from another project works fine here.
NOTARY_PROFILE="menumeters-notary"

# Keychain account of the Ed25519 key that signs updates (generate_keys
# --account). Defaults to "menumeters".
# SPARKLE_KEY_ACCOUNT="menumeters"
